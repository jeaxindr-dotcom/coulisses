index 0000000..69f166e
--- /dev/null
+++ b/src/scenes/bobine-apercu.ts
@@ -0,0 +1,65 @@
+/** Bobine d'aperçu uniquement. Le rendu conserve son chargement et ses pixels d'origine.
+ *  Au plus 12 images et 32 Mio RGBA par bobine (hors copies navigateur/GPU).
+ *  Les deux dernières images demandées sont protégées : un fondu peut lire deux instants d'une même bobine.
+ *  Une image absente lance une attente que SceneReact possède, puis redessine l'instant courant.
+ */
+export function bobineApercu(base: string, nombre: number, creerImage: () => HTMLImageElement = () => new Image()) {
+  type Entree = { image: HTMLImageElement; promise: Promise<void>; reject: (e: Error) => void; loaded: boolean; error?: Error; octets: number; ordre: number };
+  const cache = new Map<number, Entree>();
+  const demandes: number[] = [];
+  let ordre = 0, detruit = false;
+  const maxImages = 12, maxOctets = 32 * 1024 * 1024;
+  const enlever = (i: number) => {
+    const e = cache.get(i); if (!e) return;
+    cache.delete(i); e.image.onload = null; e.image.onerror = null;
+    if (!e.loaded) e.reject(new Error('Chargement de bobine annulé'));
+    e.image.removeAttribute('src');
+  };
+  const borner = () => {
+    const poids = () => [...cache.values()].reduce((s, e) => s + e.octets, 0);
+    while (cache.size > maxImages || poids() > maxOctets) {
+      const candidat = [...cache].filter(([i]) => !demandes.includes(i)).sort((a, b) => a[1].ordre - b[1].ordre)[0];
+      if (!candidat) throw new Error('Une bobine dépasse son budget de 32 Mio : fournir des images proxy moins grandes.');
+      enlever(candidat[0]);
+    }
+  };
+  const charger = (i: number): Entree => {
+    const hit = cache.get(i); if (hit) { hit.ordre = ++ordre; return hit; }
+    if (cache.size >= maxImages) {
+      const candidat = [...cache].filter(([k]) => !demandes.includes(k)).sort((a, b) => a[1].ordre - b[1].ordre)[0];
+      if (candidat) enlever(candidat[0]);
+    }
+    const image = creerImage(); let resolve!: () => void, reject!: (e: Error) => void;
+    const promise = new Promise<void>((ok, ko) => { resolve = ok; reject = ko; });
+    const e: Entree = { image, promise, reject, loaded: false, octets: 0, ordre: ++ordre };
+    cache.set(i, e); promise.catch(() => undefined); // les anticipations non consultées ne créent pas de rejet global
+    image.onload = () => {
+      if (detruit || cache.get(i) !== e) return;
+      e.octets = image.naturalWidth * image.naturalHeight * 4;
+      try { borner(); if (cache.get(i) === e) { e.loaded = true; resolve(); } }
+      catch (error) { e.error = error as Error; reject(e.error); }
+    };
+    image.onerror = () => { e.error = new Error(`Image de bobine absente : ${image.src}`); reject(e.error); };
+    image.src = `${base}f${String(i + 1).padStart(4, '0')}.jpg`;
+    borner(); return e;
+  };
+  const lire = (i: number) => {
+    if (detruit) throw new Error('Bobine déjà libérée');
+    i = Math.max(0, Math.min(nombre - 1, i));
+    const old = demandes.indexOf(i); if (old >= 0) demandes.splice(old, 1);
+    demandes.push(i); if (demandes.length > 2) demandes.shift();
+    const e = charger(i);
+    for (let k = i + 1; k <= Math.min(nombre - 1, i + 4); k++) charger(k);
+    if (e.error) throw e.error;
+    if (!e.loaded) throw e.promise;
+    return e.image;
+  };
+  return new Proxy([] as HTMLImageElement[] & { dispose?: () => void }, {
+    get(_target, key) {
+      if (key === 'dispose') return () => { detruit = true; for (const i of [...cache.keys()]) enlever(i); };
+      if (key === 'length') return nombre;
+      if (typeof key === 'string' && /^\d+$/.test(key)) return lire(Number(key));
+      return undefined;
+    },
+  });
+}
