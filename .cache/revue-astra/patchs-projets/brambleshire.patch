+/** Cache propre à l'aperçu, conservé entre montages dans la même iframe.
+ * Budget : octets de textures CPU + estimation mipmaps GPU. Les textures utilisées ne sont jamais évincées.
+ * Le chargeur borne séparément la taille de chaque jeu actif ; le budget n'est pas une mesure de toute la VRAM.
+ */
+export function createPreviewCache<T>(budget: number) {
+  type Entry = { refs: number; used: number; cancelled: boolean; value?: { data: T; bytes: number; dispose: () => void }; promise: Promise<T> };
+  const entries = new Map<string, Entry>(); let clock = 0;
+  const prune = () => {
+    let bytes = [...entries.values()].reduce((n, e) => n + (e.value?.bytes ?? 0), 0);
+    for (const [key, e] of [...entries].sort((a, b) => a[1].used - b[1].used)) {
+      if (bytes <= budget) break;
+      if (e.refs || !e.value) continue;
+      entries.delete(key); bytes -= e.value.bytes; e.value.dispose();
+    }
+  };
+  return {
+    acquire(key: string, build: (alive: () => boolean) => Promise<{ data: T; bytes: number; dispose: () => void }>) {
+      let e = entries.get(key);
+      if (!e) {
+        const entry: Entry = { refs: 0, used: ++clock, cancelled: false, promise: null as unknown as Promise<T> };
+        e = entry; entries.set(key, entry);
+        entry.promise = Promise.resolve().then(() => build(() => !entry.cancelled)).then((value) => {
+          if (entry.cancelled) { value.dispose(); throw new Error('Préparation de scène annulée'); }
+          entry.value = value; prune(); return value.data;
+        }, (error) => { if (entries.get(key) === entry) entries.delete(key); throw error; });
+        entry.promise.catch(() => undefined);
+      }
+      e.refs++; e.used = ++clock;
+      const entry = e; let released = false;
+      return { promise: entry.promise, release() {
+        if (released) return; released = true; entry.refs--;
+        if (!entry.refs && !entry.value) { entry.cancelled = true; if (entries.get(key) === entry) entries.delete(key); }
+        prune();
+      } };
+    },
+    stats() { return { entries: entries.size, refs: [...entries.values()].reduce((n, e) => n + e.refs, 0), bytes: [...entries.values()].reduce((n, e) => n + (e.value?.bytes ?? 0), 0) }; },
+  };
+}
